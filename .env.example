# SQLite works without any additional database server.
DATABASE_URL=sqlite:///./coffee_shop.db

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SEIUE OneLogin OAuth2 client settings. Register this application in OneLogin first.
ONELOGIN_BASE_URL=https://auth.beijing.academy
ONELOGIN_CLIENT_ID=
ONELOGIN_CLIENT_SECRET=
ONELOGIN_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback
AUTH_STATE_SECRET=replace-with-a-long-random-secret
