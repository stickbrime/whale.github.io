# SQLite works without any additional database server.
DATABASE_URL=sqlite:///./coffee_shop.db

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Receipt printer (USB serial / ESC-POS thermal printer)
# Set PRINTER_ENABLED=true to enable automatic receipt printing on new orders.
# PRINTER_PORT: serial device path — macOS: /dev/cu.usbserial-*, Linux: /dev/ttyUSB0
PRINTER_ENABLED=false
PRINTER_PORT=/dev/ttyUSB0
PRINTER_BAUDRATE=9600
PRINTER_WIDTH=32
PRINTER_ENCODING=gbk
PRINTER_SHOP_NAME=咖啡店
